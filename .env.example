# ============================================
# CODE ORBIT SECURITY TOOLKIT
# Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to GitHub!
# ============================================

# ============================================
# API KEYS (Optional - for enhanced features)
# ============================================

# VirusTotal API Key - for URL reputation checking
# Get it from: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB API Key - for IP reputation checking
# Get it from: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# HaveIBeenPwned API - no key required (free)
HIBP_API_ENABLED=true


# ============================================
# APPLICATION SETTINGS
# ============================================

# Set to True for development, False for production
DEBUG=True

# Secret key for session management (generate a random string)
SECRET_KEY=your_secret_key_here

# Timezone
TIMEZONE=Asia/Kolkata

# App name (shown in browser tab)
APP_NAME=Code Orbit Security Toolkit


# ============================================
# DATABASE (Optional)
# ============================================

# SQLite database path
DATABASE_URL=sqlite:///data/security.db

# For PostgreSQL (if you upgrade later)
# DATABASE_URL=postgresql://user:password@localhost/dbname


# ============================================
# EMAIL (Optional - for report sending)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Email for receiving reports
REPORT_RECIPIENT=your_email@gmail.com


# ============================================
# SECURITY SETTINGS
# ============================================

# Minimum password length for password analyzer
MIN_PASSWORD_LENGTH=8

# Maximum password length
MAX_PASSWORD_LENGTH=128

# Default port scan range (1-1024 for privileged ports)
DEFAULT_SCAN_START=1
DEFAULT_SCAN_END=1024

# Enable/disable features
ENABLE_PASSWORD_GENERATOR=true
ENABLE_PHISHING_DETECTION=true
ENABLE_PORT_SCANNER=true
ENABLE_REPORT_GENERATION=true


# ============================================
# LOGGING
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/app.log


# ============================================
# RATE LIMITING (if you add API endpoints)
# ============================================

RATE_LIMIT_PER_MINUTE=60


# ============================================
# CORS (if you deploy as API)
# ============================================

CORS_ORIGINS=http://localhost:8501,https://your-app.onrender.com


# ============================================
# DEPLOYMENT SETTINGS
# ============================================

# For Render.com deployment
RENDER=true
PORT=8501

# For Docker deployment
DOCKER_ENV=false


# ============================================
# SAMPLE VALUES (uncomment to test)
# ============================================

# VIRUSTOTAL_API_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
# SECRET_KEY=your-secret-key-here-minimum-32-characters-long
# DEBUG=False